{
    "name": "@workleap/create-schemas",
    "author": "Workleap",
    "version": "0.4.0",
    "description": "CLI to generate Typescript schemas from an OpenAPI document",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-openapi-typescript.git",
        "directory": "packages/create-schemas"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "type": "module",
    "bin": {
        "create-schemas": "./bin/create-schemas.js"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./plugins": {
            "import": "./dist/plugins/index.js",
            "types": "./dist/plugins/index.d.ts"
        }
    },
    "files": [
        "bin",
        "dist"
    ],
    "scripts": {
        "dev": "tsup --config tsup.dev.ts",
        "test": "vitest",
        "test-update": "vitest -- update-snapshots",
        "build": "tsup --config tsup.build.ts"
    },
    "devDependencies": {
        "@swc/helpers": "0.5.11",
        "@types/node": "26.6.5",
        "@workleap/eslint-plugin": "3.2.2",
        "@workleap/swc-configs": "2.2.3",
        "@workleap/tsup-configs": "5.0.0",
        "eslint": "10.13.0",
        "tsup": "9.0.0",
        "vitest": "1.6.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "c12": "3.3.4",
        "chokidar": "6.0.0",
        "commander": "15.0.0",
        "kleur": "4.1.5",
        "openapi-typescript": "7.13.0",
        "typescript": "7.0.2",
        "zod": "4.6.7"
    }
}
